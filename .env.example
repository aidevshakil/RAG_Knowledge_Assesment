# ---------------------------------------------------------------------------
# Copy to `.env` and fill in what you use. Everything has a working default,
# so the app also boots with an empty file (offline mode).
# ---------------------------------------------------------------------------

# ---- Embeddings -----------------------------------------------------------
# huggingface | openai | hashing   (hashing = dependency-free, offline demo)
EMBEDDING_PROVIDER=huggingface
# huggingface: any sentence-transformers model
#   sentence-transformers/all-MiniLM-L6-v2        -> 384 dims  (fast, cheap)
#   sentence-transformers/all-mpnet-base-v2       -> 768 dims  (better recall)
#   BAAI/bge-large-en-v1.5                        -> 1024 dims (best, slowest)
# openai: text-embedding-3-small (1536) | text-embedding-3-large (3072)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: truncate embeddings to N dims (OpenAI v3 / Matryoshka models only).
# Use it to study the accuracy-vs-cost trade-off of vector dimensionality.
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64

# ---- Vector store ---------------------------------------------------------
# chroma | faiss | numpy
VECTOR_STORE=chroma
VECTOR_COLLECTION=knowledge_base

# ---- LLM ------------------------------------------------------------------
# groq | openai | anthropic | extractive   (extractive = no API key needed)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Chunking / retrieval -------------------------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
# Drop hits below this cosine similarity (0 disables the filter).
MIN_SCORE=0.15
# Maximal Marginal Relevance: 1.0 = pure relevance, 0.0 = pure diversity.
MMR_LAMBDA=0.7
# Candidate pool multiplier used before MMR re-ranking.
FETCH_K_MULTIPLIER=4

# ---- Evaluation -----------------------------------------------------------
# Use the LLM as a faithfulness judge (extra call per query, more accurate).
ENABLE_LLM_JUDGE=false

# ---- Paths / misc ---------------------------------------------------------
DATA_DIR=data
LOG_LEVEL=INFO
